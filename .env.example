# ===== Real-time data provider configuration =====

# Binance REST base URL (change to https://api.binance.us if geo-blocked)
BINANCE_REST_URL=https://api.binance.com
# Binance websocket stream base (change to wss://stream.binance.us:9443 if needed)
BINANCE_WS_URL=wss://stream.binance.com:9443

# Optional PSX live quote endpoint (if you have access). Leave empty to
# fall back to Yahoo Finance delayed quotes for Pakistan stocks.
PSX_API_BASE=

# ===== Engine timing (seconds) =====
POLL_INTERVAL=10        # quote refresh cadence
ANALYZE_INTERVAL=60     # full multi-horizon re-analysis cadence
FUNDAMENTAL_INTERVAL=1800 # how often fundamentals are re-pulled (30 min)
CANDLE_REFRESH_INTERVAL=300 # re-sync candle history from provider (5 min)

# ===== Universe =====
# Comma-separated lists. Crypto pairs are mapped to <SYMBOL>USDT on Binance
# and <SYMBOL>-USD on Yahoo. PSX symbols use the Yahoo Karachi suffix.
CRYPTO_SYMBOLS=BTC,ETH,SOL,BNB,XRP,DOGE
PSX_SYMBOLS=KEL.KA,EFERT.KA,OGDC.KA,MARI.KA,LUCK.KA,HUBC.KA,SYS.KA,MEBL.KA

# ===== Alerts =====
ALERTS_ENABLED=true
# Desktop notifications on macOS (uses osascript; requires notification permission)
DESKTOP_ALERTS=true
# Optional webhook (Discord/Slack/Telegram) for alert fan-out
ALERT_WEBHOOK_URL=

# Telegram (blocked in Pakistan, optional elsewhere)
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=

# Free Email notifications - works in Pakistan via Gmail SMTP app password
# Create an app password: Google Account > Security > 2-Step Verification > App passwords
#EMAIL_FROM=you@gmail.com
#EMAIL_TO=03242434338@...  (your mobile push email, or your gmail)
#EMAIL_APP_PASSWORD=
#EMAIL_SMTP_HOST=smtp.gmail.com
#EMAIL_SMTP_PORT=587

# ===== Web server =====
HOST=127.0.0.1
PORT=8000

# ===== ML models =====
# Whether to load the optional ML direction probability models if present
USE_ML=true

# ===== Storage =====
DB_PATH=data/signals.db
MODELS_DIR=models